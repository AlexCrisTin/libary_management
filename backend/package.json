{
  "name": "library-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Library Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/setup-database.js",
