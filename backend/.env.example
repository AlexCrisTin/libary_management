PORT=3000
HOST=0.0.0.0
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db
DB_PORT=3306
# Bắt buộc: tạo khóa riêng bằng `openssl rand -hex 32`, không commit khóa thật.
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEV_OTP_ENABLED=false

# Phân tách bằng dấu phẩy. Ứng dụng mobile không gửi Origin nên vẫn hoạt động.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# OpenRouter AI Assistant Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Library Management AI
AI_MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT_MS=30000

# Background automation jobs
AUTOMATIONS_ENABLED=true
OVERDUE_SCAN_INTERVAL_MINUTES=60
CARD_SCAN_INTERVAL_MINUTES=60
PICKUP_SCAN_INTERVAL_MINUTES=15
HOLD_SCAN_INTERVAL_MINUTES=15
